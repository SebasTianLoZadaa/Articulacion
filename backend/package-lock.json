{
  "name": "backend",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "author": "Juan Lozada",
  "description": "Backend para sistema de Ecomerce con Node.js, Express y Sequelize",
  "keywords": [
    "e-commerce",
    "nodejs",
    "express",
    "sequelize",
    "jwt",
    "mysql"
  ],
  "license": "ISC",
  "main": "server.js",
  "packages": {},
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "init-db": "node config/createDataBase.js",
    "reset-db": "node config/resetDataBase.js",
    "seed": "node -e \"require('./seeders/adminSeeder').runSeeders().then(() => process.exit(0)).catch((err) => { console.error(err); process.exit(1); })\"",
    "start": "node server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test-watch": "jest --watch",
    "test:coverage": "jest --coverage"
  }
}
